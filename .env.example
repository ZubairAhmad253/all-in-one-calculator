# Public site URL used for canonical links and the sitemap, e.g. https://mycalc.com.
# Leave unset on Vercel until you have a domain: the *.vercel.app address is used.
SITE_URL=https://example.com

# Google AdSense publisher ID (ca-pub-XXXXXXXXXXXXXXXX). Leave empty to
# render reserved placeholder boxes instead of live ads.
PUBLIC_ADSENSE_CLIENT=
