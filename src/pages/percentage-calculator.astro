---
import CalculatorLayout from '@/layouts/CalculatorLayout.astro';
import PercentageCalculator from '@/components/calculators/PercentageCalculator';

const faqs = [
  {
    q: 'How do I calculate a percentage of a number?',
    a: 'Divide the percentage by 100 and multiply by the number. 15% of 200 is 15 ÷ 100 × 200 = 30. A quick trick: 10% is the number divided by 10, so 10% of 200 is 20, and 5% is half of that.',
  },
  {
    q: 'How do I work out a percentage increase or decrease?',
    a: 'Subtract the old value from the new one, divide by the old value and multiply by 100. From 80 to 100: (100 − 80) ÷ 80 × 100 = 25% increase. A negative answer means a decrease: from 100 to 80 is a 20% decrease.',
  },
  {
    q: 'Why is a 25% increase not undone by a 25% decrease?',
    a: 'Because each percentage is taken of a different starting value. 80 up 25% is 100, but 100 down 25% is 75, not 80. To get back from 100 to 80 you need a 20% decrease.',
  },
  {
    q: 'What is the difference between percentage change and percentage difference?',
    a: 'Percentage change compares a new value with an original one, so the order matters. Percentage difference compares two values where neither is the starting point, using their average, so the order doesn’t matter. 80 and 100 have a 22.22% difference.',
  },
  {
    q: 'What is the difference between percent and percentage points?',
    a: 'Percentage points are the simple difference between two percentages. If an interest rate rises from 4% to 5%, it has gone up 1 percentage point, which is a 25% increase in the rate itself.',
  },
];
---

<CalculatorLayout
  slug="percentage-calculator"
  title="Percentage Calculator – Percent Of, Change & Difference"
  description="Free percentage calculator. Find a percentage of a number, what percent one number is of another, percentage increase or decrease, and percentage difference."
  intro="Answer the four everyday percentage questions at once: a percentage of a number, what percent one number is of another, percentage change and percentage difference."
  faqs={faqs}
  updated="2026-09-24"
>
  <PercentageCalculator client:load />

  <Fragment slot="learn">
    <h2>How to use the percentage calculator</h2>
    <p>Each box answers a different question. Type your numbers into the one you need; the answer and the working update instantly. <strong>Share</strong> saves every box’s numbers in the link.</p>

    <h2>Percentage formulas</h2>
    <table>
      <thead><tr><th>Question</th><th>Formula</th><th>Example</th></tr></thead>
      <tbody>
        <tr><td>What is P% of X?</td><td>P ÷ 100 × X</td><td>15% of 200 = 30</td></tr>
        <tr><td>A is what % of B?</td><td>A ÷ B × 100</td><td>30 is 15% of 200</td></tr>
        <tr><td>% change from A to B</td><td>(B − A) ÷ |A| × 100</td><td>80 → 100 = +25%</td></tr>
        <tr><td>% difference of A and B</td><td>|A − B| ÷ ((A + B) ÷ 2) × 100</td><td>80 and 100 = 22.22%</td></tr>
      </tbody>
    </table>

    <h3>Worked example: a pay rise</h3>
    <p>
      Your salary goes from <strong>$48,000</strong> to <strong>$51,600</strong>. The change is (51,600 − 48,000) ÷ 48,000 × 100 = <strong>7.5%</strong>. If it then grows another 7.5%, it
      becomes 51,600 + 7.5% of 51,600 = $55,470.
    </p>

    <h3>Worked example: a test score</h3>
    <p>You score <strong>42 out of 60</strong>. As a percentage: 42 ÷ 60 × 100 = <strong>70%</strong>.</p>

    <h2>Finding the original number</h2>
    <p>
      If a price is <strong>$60 after a 25% discount</strong>, you paid 75% of the original. Divide by 0.75 to go back: 60 ÷ 0.75 = <strong>$80</strong>. Taking 25% of $60 and adding it back
      ($75) is a common mistake.
    </p>

    <h2>Quick percentage table</h2>
    <table>
      <thead><tr><th>Percentage</th><th>As a fraction</th><th>As a decimal</th><th>Of 200</th></tr></thead>
      <tbody>
        <tr><td>1%</td><td>1/100</td><td>0.01</td><td>2</td></tr>
        <tr><td>5%</td><td>1/20</td><td>0.05</td><td>10</td></tr>
        <tr><td>10%</td><td>1/10</td><td>0.1</td><td>20</td></tr>
        <tr><td>12.5%</td><td>1/8</td><td>0.125</td><td>25</td></tr>
        <tr><td>20%</td><td>1/5</td><td>0.2</td><td>40</td></tr>
        <tr><td>25%</td><td>1/4</td><td>0.25</td><td>50</td></tr>
        <tr><td>33⅓%</td><td>1/3</td><td>0.333…</td><td>66.67</td></tr>
        <tr><td>50%</td><td>1/2</td><td>0.5</td><td>100</td></tr>
        <tr><td>75%</td><td>3/4</td><td>0.75</td><td>150</td></tr>
      </tbody>
    </table>
    <p>
      Working with prices? The <a href="/discount-calculator">discount calculator</a> and <a href="/sales-tax-calculator">sales tax calculator</a> handle stacked discounts and tax for you.
    </p>
  </Fragment>
</CalculatorLayout>
