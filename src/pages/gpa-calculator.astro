---
import CalculatorLayout from '@/layouts/CalculatorLayout.astro';
import GpaCalculator from '@/components/calculators/GpaCalculator';

const faqs = [
  {
    q: 'How is GPA calculated?',
    a: 'Convert each letter grade to grade points (A = 4.0, B = 3.0 and so on), multiply by the course’s credit hours, add those up, and divide by the total credits. A GPA is a credit-weighted average, so a 4-credit course counts more than a 1-credit one.',
  },
  {
    q: 'How do I calculate my cumulative GPA?',
    a: 'Multiply your current GPA by the credits you’ve completed to get your grade points so far, add this term’s grade points, and divide by all your credits. A 3.5 GPA over 30 credits plus a 3.0 term of 15 credits gives (105 + 45) ÷ 45 = 3.33.',
  },
  {
    q: 'Is an A+ worth 4.0 or 4.3?',
    a: 'It depends on the school. Most US colleges cap grade points at 4.0, so A+ and A both count as 4.0. Some give A+ 4.3. Tick “Count A+ as 4.3” if your school does.',
  },
  {
    q: 'What is a good GPA?',
    a: 'As a rough guide, 3.0 (a B average) is generally considered good, 3.5 and above is very good, and many competitive programmes look for 3.7 or higher. Requirements vary a lot by school and course.',
  },
  {
    q: 'Does this work for weighted high-school GPAs?',
    a: 'This calculator gives an unweighted GPA on the standard 4.0 scale. Many high schools add an extra point for honors, AP or IB classes (a weighted GPA). Check your school’s policy for how those are counted.',
  },
];
---

<CalculatorLayout
  slug="gpa-calculator"
  title="GPA Calculator – Semester & Cumulative GPA (4.0 Scale)"
  description="Free GPA calculator. Work out your semester GPA from letter grades and credit hours on the 4.0 scale, and your cumulative GPA including previous terms."
  intro="Work out your term GPA from your letter grades and credit hours on the 4.0 scale, and see your cumulative GPA when you add the credits you’ve already completed."
  faqs={faqs}
  updated="2026-09-27"
>
  <GpaCalculator client:load />

  <Fragment slot="learn">
    <h2>How to use the GPA calculator</h2>
    <ol>
      <li><strong>Add each course</strong> with its letter grade and credit hours.</li>
      <li><strong>Tick “Count A+ as 4.3”</strong> if your school uses that scale.</li>
      <li><strong>For a cumulative GPA,</strong> enter your current GPA and credits completed.</li>
    </ol>

    <h2>GPA formula</h2>
    <div class="formula">GPA = Σ (grade points × credits) ÷ Σ credits</div>

    <h3>Worked example</h3>
    <table>
      <thead><tr><th>Course</th><th>Grade</th><th>Points</th><th>Credits</th><th>Points × credits</th></tr></thead>
      <tbody>
        <tr><td>1</td><td>A</td><td>4.0</td><td>3</td><td>12.0</td></tr>
        <tr><td>2</td><td>B+</td><td>3.3</td><td>4</td><td>13.2</td></tr>
        <tr><td>3</td><td>B</td><td>3.0</td><td>3</td><td>9.0</td></tr>
        <tr><td>4</td><td>C</td><td>2.0</td><td>2</td><td>4.0</td></tr>
        <tr><td><strong>Total</strong></td><td></td><td></td><td><strong>12</strong></td><td><strong>38.2</strong></td></tr>
      </tbody>
    </table>
    <p>38.2 ÷ 12 = <strong>3.18 GPA</strong>.</p>

    <h2>Letter grades and grade points</h2>
    <table>
      <thead><tr><th>Letter</th><th>Points</th><th>Typical percentage</th></tr></thead>
      <tbody>
        <tr><td>A+ / A</td><td>4.0 (A+ sometimes 4.3)</td><td>93–100%</td></tr>
        <tr><td>A−</td><td>3.7</td><td>90–92%</td></tr>
        <tr><td>B+</td><td>3.3</td><td>87–89%</td></tr>
        <tr><td>B</td><td>3.0</td><td>83–86%</td></tr>
        <tr><td>B−</td><td>2.7</td><td>80–82%</td></tr>
        <tr><td>C+</td><td>2.3</td><td>77–79%</td></tr>
        <tr><td>C</td><td>2.0</td><td>73–76%</td></tr>
        <tr><td>C−</td><td>1.7</td><td>70–72%</td></tr>
        <tr><td>D+ / D / D−</td><td>1.3 / 1.0 / 0.7</td><td>60–69%</td></tr>
        <tr><td>F</td><td>0.0</td><td>Below 60%</td></tr>
      </tbody>
    </table>
    <p>Scales differ between schools and countries, so check your own institution’s grading policy.</p>

    <h2>How to raise your GPA</h2>
    <ul>
      <li><strong>Focus on high-credit courses:</strong> they move your GPA the most.</li>
      <li><strong>Check your retake policy:</strong> some schools replace the old grade.</li>
      <li><strong>Plan ahead</strong> with the <a href="/grade-calculator">grade calculator</a> to see what you need on your finals.</li>
    </ul>
  </Fragment>
</CalculatorLayout>
