---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" description="The page you were looking for could not be found." noindex>
  <div class="container-page py-24 text-center">
    <p class="text-sm font-semibold text-brand">404</p>
    <h1 class="mt-2 text-3xl font-bold tracking-tight">Page not found</h1>
    <p class="mt-3 text-muted">Try searching with <kbd class="rounded-md border border-line bg-surface px-1.5 text-xs">Ctrl K</kbd> or go back to the home page.</p>
    <a href="/" class="mt-8 inline-block rounded-xl bg-brand px-5 py-2.5 font-semibold text-brand-fg">All calculators</a>
  </div>
</BaseLayout>
