 * Review with the site owner (ideally with legal advice) before launch,
 * and add a governing-law clause once the owner's jurisdiction is decided.
 */
import LegalPage from '@/components/layout/LegalPage.astro';
import { SITE } from '@/config/site';
---

<LegalPage title="Terms of Use" heading="Terms of use" description={`The terms for using ${SITE.name}, its calculators and articles.`}>
  <p>These terms apply when you use {SITE.name} (“the site”). By using the site you agree to them. If you don’t agree, please don’t use the site.</p>

  <h2>Using the site</h2>
  <p>You may use the calculators and articles free of charge for personal, educational and business purposes. Please don’t:</p>
  <ul>
    <li>copy or republish substantial parts of the site, or present our content as your own;</li>
    <li>use automated tools to scrape the site or send it excessive traffic;</li>
    <li>try to interfere with the site’s security, ads or normal operation.</li>
  </ul>
  <p>Linking to any page, and sharing result links, is welcome.</p>

  <h2>Estimates, not advice</h2>
  <p>
    Results are estimates based on the information you enter and the standard formulas described on each page. They are for general information only and are not financial, investment, tax,
    legal, medical or professional advice. Real figures, such as loan offers, tax bills, health measurements or building quantities, can differ. Please read our <a href="/disclaimer">disclaimer</a>
    and speak to a qualified professional before making important decisions.
  </p>

  <h2>Accuracy</h2>
  <p>
    We work hard to keep the calculators accurate and test them against known results, but we can’t guarantee that everything is complete, current or error-free. Exchange rates, tax rates and
    other figures can change. If you find a mistake, please <a href="/contact">tell us</a>.
  </p>

  <h2>No warranty</h2>
  <p>The site is provided “as is” and “as available”, without warranties of any kind, express or implied, including fitness for a particular purpose and non-infringement.</p>

  <h2>Limitation of liability</h2>
  <p>
    To the fullest extent allowed by law, we are not liable for any loss or damage arising from your use of, or reliance on, the site or its results, including indirect or consequential loss.
    Nothing in these terms limits liability that can’t be limited by law.
  </p>

  <h2>Content and trademarks</h2>
  <p>The site’s text, design, graphics and code are owned by us or used with permission. Third-party names and trademarks mentioned belong to their owners.</p>

  <h2>Advertising and links</h2>
  <p>The site shows ads and may link to other websites. We don’t control and aren’t responsible for their content, products or privacy practices.</p>

  <h2>Privacy</h2>
  <p>Our <a href="/privacy">privacy policy</a> explains how information is handled.</p>

  <h2>Changes</h2>
  <p>We may change these terms or the site at any time. The date at the top shows when these terms last changed; continuing to use the site means you accept the current version.</p>

  <h2>Contact</h2>
  <p>Questions about these terms? Email <a href={`mailto:${SITE.email}`}>{SITE.email}</a>.</p>
</LegalPage>
