---
import CalculatorLayout from '@/layouts/CalculatorLayout.astro';
import ExponentCalculator from '@/components/calculators/ExponentCalculator';

const faqs = [
  {
    q: 'What is an exponent?',
    a: 'An exponent says how many times to multiply a number (the base) by itself. In 2⁵, the base is 2 and the exponent is 5: 2 × 2 × 2 × 2 × 2 = 32.',
  },
  {
    q: 'What does a negative exponent mean?',
    a: 'A negative exponent means “one divided by” the positive power: 2⁻³ = 1 ÷ 2³ = 1/8 = 0.125.',
  },
  {
    q: 'What does a fractional exponent mean?',
    a: 'A fractional exponent is a root. x^(1/2) is the square root of x, and x^(1/3) is the cube root. x^(2/3) is the cube root of x, squared: 8^(2/3) = 2² = 4.',
  },
  {
    q: 'Why is any number to the power of 0 equal to 1?',
    a: 'Because dividing powers subtracts exponents: xⁿ ÷ xⁿ = x⁰, and anything divided by itself is 1. 0⁰ is a special case, usually defined as 1 in algebra.',
  },
  {
    q: 'How big is 2 to the power of 64?',
    a: '2⁶⁴ = 18,446,744,073,709,551,616, about 18 quintillion. It’s the famous number of grains in the chessboard legend, where each square doubles the last.',
  },
];
---

<CalculatorLayout
  slug="exponent-calculator"
  title="Exponent Calculator – Powers, Negative & Fractional"
  description="Free exponent calculator. Raise any number to any power, including negative and fractional exponents, with exact results for large whole-number powers."
  intro="Raise any number to any power, including negative and fractional exponents, with the exact value of large whole-number powers and a plain explanation."
  faqs={faqs}
  updated="2026-09-27"
>
  <ExponentCalculator client:load />

  <Fragment slot="learn">
    <h2>How to use the exponent calculator</h2>
    <p>Enter the base and the exponent. Decimals and negative numbers work too. Large whole-number powers such as 2¹⁰⁰ are also shown exactly, digit by digit.</p>

    <h2>Laws of exponents</h2>
    <table>
      <thead><tr><th>Rule</th><th>Example</th></tr></thead>
      <tbody>
        <tr><td>aᵐ × aⁿ = aᵐ⁺ⁿ</td><td>2³ × 2⁴ = 2⁷ = 128</td></tr>
        <tr><td>aᵐ ÷ aⁿ = aᵐ⁻ⁿ</td><td>5⁶ ÷ 5⁴ = 5² = 25</td></tr>
        <tr><td>(aᵐ)ⁿ = aᵐⁿ</td><td>(3²)³ = 3⁶ = 729</td></tr>
        <tr><td>a⁰ = 1</td><td>7⁰ = 1</td></tr>
        <tr><td>a⁻ⁿ = 1 ÷ aⁿ</td><td>2⁻³ = 0.125</td></tr>
        <tr><td>a^(1/n) = ⁿ√a</td><td>27^(1/3) = 3</td></tr>
        <tr><td>(ab)ⁿ = aⁿbⁿ</td><td>(2 × 3)² = 4 × 9 = 36</td></tr>
      </tbody>
    </table>

    <h2>Powers of 2 and 10</h2>
    <table>
      <thead><tr><th>n</th><th>2ⁿ</th><th>10ⁿ</th></tr></thead>
      <tbody>
        <tr><td>1</td><td>2</td><td>10</td></tr>
        <tr><td>5</td><td>32</td><td>100,000</td></tr>
        <tr><td>10</td><td>1,024</td><td>10 billion (10¹⁰)</td></tr>
        <tr><td>20</td><td>1,048,576</td><td>10²⁰</td></tr>
        <tr><td>32</td><td>4,294,967,296</td><td>10³²</td></tr>
      </tbody>
    </table>
    <p>To go the other way, finding the exponent, use the <a href="/logarithm-calculator">logarithm calculator</a>.</p>
  </Fragment>
</CalculatorLayout>
