---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { categoryById, type CategoryId } from '@/data/categories';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const date = (d: Date) => d.toLocaleDateString('en', { year: 'numeric', month: 'short', day: 'numeric' });
---

<BaseLayout title="Blog – Guides to Money, Health and Everyday Maths" description="Plain-English guides that explain the maths behind mortgages, interest, BMI, calories, percentages and more, with worked examples.">
  <div class="container-page pt-10">
    <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">Blog</h1>
    <p class="mt-3 max-w-2xl text-lg text-muted">Guides that explain the maths behind everyday decisions.</p>

    <div class="mt-10 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
      {
        posts.map((p) => (
          <a href={`/blog/${p.id}`} class="card group flex flex-col p-6">
            <p class="text-xs font-medium tracking-wide text-brand uppercase">{categoryById(p.data.category as CategoryId).name}</p>
            <h2 class="mt-2 text-lg font-semibold group-hover:text-brand">{p.data.title}</h2>
            <p class="mt-2 flex-1 text-sm text-muted">{p.data.description}</p>
            <p class="mt-4 text-xs text-muted">{date(p.data.pubDate)}</p>
          </a>
        ))
      }
    </div>
  </div>
</BaseLayout>
