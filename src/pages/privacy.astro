---
/*
 * TEMPLATE: review this with the site owner (and ideally a legal adviser)
 * before launch. Google AdSense requires a privacy policy that discloses
 * its use of cookies. Visitors in the EU/UK also need a consent banner
 * (a Google-certified CMP) before personalised ads are shown.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import { SITE } from '@/config/site';
---

<BaseLayout title="Privacy Policy" description={`How ${SITE.name} handles your data, cookies and advertising.`}>
  <div class="container-page max-w-3xl pt-10">
    <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">Privacy policy</h1>
    <div class="prose-content mt-6">
      <h2>Numbers you enter</h2>
      <p>Calculations run entirely in your browser. The values you type are not sent to or stored on our servers. If you use <strong>Share result</strong>, your inputs are placed in the page link so that anyone you send it to can see them.</p>
      <h2>Advertising</h2>
      <p>
        We show ads from Google AdSense. Google and its partners use cookies to serve ads based on your previous visits to this and other websites. You can opt out of personalised advertising at
        <a href="https://adssettings.google.com" rel="noopener">Google Ads Settings</a>. Learn more about <a href="https://policies.google.com/technologies/partner-sites" rel="noopener">how Google uses data from partner sites</a>.
      </p>
      <h2>Preferences</h2>
      <p>We store your light or dark theme choice in your browser's local storage. It never leaves your device.</p>
      <h2>Changes</h2>
      <p>We may update this policy from time to time. The latest version will always be on this page.</p>
    </div>
  </div>
</BaseLayout>
