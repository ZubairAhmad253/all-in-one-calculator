---
import CalculatorLayout from '@/layouts/CalculatorLayout.astro';
import LcmGcdCalculator from '@/components/calculators/LcmGcdCalculator';

const faqs = [
  {
    q: 'What is the GCD (or HCF)?',
    a: 'The greatest common divisor, also called the highest common factor (HCF) or greatest common factor (GCF), is the largest whole number that divides all the numbers exactly. The GCD of 12, 18 and 30 is 6.',
  },
  {
    q: 'What is the LCM?',
    a: 'The least common multiple is the smallest positive number that all the numbers divide into. The LCM of 12, 18 and 30 is 180.',
  },
  {
    q: 'How do I find the GCD and LCM using prime factors?',
    a: 'Write each number as a product of primes. For the GCD, multiply the primes common to all of them at their lowest power; for the LCM, multiply every prime at its highest power. 12 = 2² × 3 and 18 = 2 × 3², so GCD = 2 × 3 = 6 and LCM = 2² × 3² = 36.',
  },
  {
    q: 'What is Euclid’s algorithm?',
    a: 'A fast way to find the GCD of two numbers: divide the larger by the smaller, then keep dividing the previous divisor by the remainder until the remainder is 0. The last non-zero remainder is the GCD.',
  },
  {
    q: 'How are GCD and LCM related?',
    a: 'For two numbers, GCD × LCM = the product of the numbers. For 12 and 18: 6 × 36 = 216 = 12 × 18.',
  },
];
---

<CalculatorLayout
  slug="lcm-gcd-calculator"
  title="LCM & GCD Calculator – HCF and LCM of Numbers"
  description="Free LCM and GCD calculator. Find the least common multiple and greatest common divisor (HCF) of two or more numbers, with prime factors and Euclid's algorithm."
  intro="Find the greatest common divisor (HCF) and least common multiple of two or more numbers, with each number’s prime factors and step-by-step working."
  faqs={faqs}
  updated="2026-09-27"
>
  <LcmGcdCalculator client:load />

  <Fragment slot="learn">
    <h2>How to use the LCM and GCD calculator</h2>
    <p>Type two or more whole numbers, separated by commas or spaces. You’ll see the GCD, the LCM, each number’s prime factorisation and, for two numbers, Euclid’s algorithm.</p>

    <h2>Methods</h2>
    <div class="formula">GCD = product of common primes at their lowest power &nbsp;&nbsp; LCM = product of all primes at their highest power</div>
    <div class="formula">For two numbers: LCM(a, b) = a × b ÷ GCD(a, b)</div>

    <h3>Worked example</h3>
    <table>
      <thead><tr><th>Number</th><th>Prime factors</th></tr></thead>
      <tbody>
        <tr><td>12</td><td>2² × 3</td></tr>
        <tr><td>18</td><td>2 × 3²</td></tr>
        <tr><td>30</td><td>2 × 3 × 5</td></tr>
      </tbody>
    </table>
    <p>Common to all: one 2 and one 3, so the <strong>GCD is 6</strong>. Highest powers of every prime: 2² × 3² × 5, so the <strong>LCM is 180</strong>.</p>

    <h2>Where you use them</h2>
    <ul>
      <li><strong>GCD:</strong> simplifying fractions (18/30 = 3/5, dividing by 6) and splitting things into equal groups.</li>
      <li><strong>LCM:</strong> adding fractions with a common denominator, and working out when repeating events line up.</li>
    </ul>
    <p>Simplify and add fractions with the <a href="/fraction-calculator">fraction calculator</a>.</p>
  </Fragment>
</CalculatorLayout>
