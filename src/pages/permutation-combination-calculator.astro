---
import CalculatorLayout from '@/layouts/CalculatorLayout.astro';
import PermutationCombinationCalculator from '@/components/calculators/PermutationCombinationCalculator';

const faqs = [
  {
    q: 'What is the difference between a permutation and a combination?',
    a: 'In a permutation the order matters; in a combination it doesn’t. Picking a president, secretary and treasurer from 10 people is a permutation (720 ways). Picking any 3-person committee is a combination (120 ways).',
  },
  {
    q: 'What is the nCr formula?',
    a: 'C(n, r) = n! ÷ (r! × (n − r)!). For choosing 3 from 10: 10! ÷ (3! × 7!) = 3,628,800 ÷ (6 × 5,040) = 120.',
  },
  {
    q: 'What is the nPr formula?',
    a: 'P(n, r) = n! ÷ (n − r)!. For arranging 3 of 10: 10 × 9 × 8 = 720. It equals C(n, r) × r!, because each group of 3 can be ordered 3! = 6 ways.',
  },
  {
    q: 'What are the odds of winning a 6/49 lottery?',
    a: 'There are C(49, 6) = 13,983,816 ways to choose 6 numbers from 49, and order doesn’t matter, so a single ticket has a 1 in 13,983,816 chance of the jackpot.',
  },
  {
    q: 'Is a combination lock really a combination?',
    a: 'No. The order of the digits matters and digits can repeat, so it’s a permutation with repetition. A 4-digit lock has 10⁴ = 10,000 possible codes.',
  },
];
---

<CalculatorLayout
  slug="permutation-combination-calculator"
  title="Permutation and Combination Calculator – nPr & nCr"
  description="Free permutation and combination calculator. Find nPr and nCr exactly, with or without repetition, for lotteries, passwords, teams and card hands."
  intro="Count the ways to choose or arrange r items from n: permutations (nPr) and combinations (nCr), with or without repetition, calculated exactly."
  faqs={faqs}
  updated="2026-09-27"
>
  <PermutationCombinationCalculator client:load />

  <Fragment slot="learn">
    <h2>How to use the permutation and combination calculator</h2>
    <ol>
      <li><strong>Enter n</strong>, the number of items to choose from, and <strong>r</strong>, how many you pick.</li>
      <li><strong>Say whether order matters.</strong> A podium finish or a PIN: yes. A team or a lottery ticket: no.</li>
      <li><strong>Say whether items can repeat.</strong> Digits in a PIN can; people on a committee can’t.</li>
    </ol>
    <p>All four answers are shown; tap one to switch. Results are exact, even with hundreds of digits.</p>

    <h2>The four formulas</h2>
    <table>
      <thead><tr><th></th><th>No repetition</th><th>With repetition</th></tr></thead>
      <tbody>
        <tr><td><strong>Order matters</strong></td><td>n! ÷ (n − r)!</td><td>nʳ</td></tr>
        <tr><td><strong>Order doesn’t matter</strong></td><td>n! ÷ (r! (n − r)!)</td><td>(n + r − 1)! ÷ (r! (n − 1)!)</td></tr>
      </tbody>
    </table>

    <h3>Worked examples</h3>
    <table>
      <thead><tr><th>Question</th><th>Type</th><th>Answer</th></tr></thead>
      <tbody>
        <tr><td>Gold, silver, bronze among 8 runners</td><td>P(8, 3)</td><td>336</td></tr>
        <tr><td>3 toppings from 8</td><td>C(8, 3)</td><td>56</td></tr>
        <tr><td>5-card poker hands</td><td>C(52, 5)</td><td>2,598,960</td></tr>
        <tr><td>4-letter codes from A–Z</td><td>26⁴</td><td>456,976</td></tr>
        <tr><td>3 scoops from 5 flavours, repeats allowed</td><td>C(5 + 3 − 1, 3)</td><td>35</td></tr>
      </tbody>
    </table>
    <p>For n! on its own, use the <a href="/factorial-calculator">factorial calculator</a>. To turn counts into chances, try the <a href="/probability-calculator">probability calculator</a>.</p>
  </Fragment>
</CalculatorLayout>
