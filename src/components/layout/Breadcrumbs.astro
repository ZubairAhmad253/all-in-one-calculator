---
import Icon from '@/components/ui/Icon.astro';
export interface Crumb {
  name: string;
  href: string;
}
interface Props {
  items: Crumb[];
}
const { items } = Astro.props;
---

<nav aria-label="Breadcrumb" class="text-sm text-muted">
  <ol class="flex flex-wrap items-center gap-1">
    {
      items.map((c, i) => (
        <li class="flex items-center gap-1">
          {i > 0 && <Icon name="chevron" class="size-3.5 opacity-60" />}
          {i < items.length - 1 ? (
            <a href={c.href} class="hover:text-fg">{c.name}</a>
          ) : (
            <span aria-current="page" class="text-fg">{c.name}</span>
          )}
        </li>
      ))
    }
  </ol>
</nav>
