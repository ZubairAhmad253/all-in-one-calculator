---
import { SITE } from '@/config/site';
import { CATEGORIES } from '@/data/categories';
const year = new Date().getFullYear();
---

<footer class="mt-24 border-t border-line bg-surface">
  <div class="container-page grid gap-10 py-12 sm:grid-cols-2 lg:grid-cols-4">
    <div class="lg:col-span-2">
      <p class="font-semibold">{SITE.name}</p>
      <p class="mt-2 max-w-sm text-sm text-muted">{SITE.tagline}. Results are estimates for information only and are not financial, medical or legal advice.</p>
    </div>
    <nav aria-label="Categories">
      <p class="text-sm font-semibold">Calculators</p>
      <ul class="mt-3 space-y-2 text-sm text-muted">
        {CATEGORIES.map((c) => <li><a class="hover:text-fg" href={`/category/${c.id}`}>{c.name}</a></li>)}
      </ul>
    </nav>
    <nav aria-label="Site">
      <p class="text-sm font-semibold">Site</p>
      <ul class="mt-3 space-y-2 text-sm text-muted">
        <li><a class="hover:text-fg" href="/blog">Blog</a></li>
        <li><a class="hover:text-fg" href="/about">About</a></li>
        <li><a class="hover:text-fg" href="/privacy">Privacy policy</a></li>
      </ul>
    </nav>
  </div>
  <div class="border-t border-line py-6 text-center text-xs text-muted">© {year} {SITE.name}</div>
</footer>
