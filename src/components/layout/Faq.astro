---
export interface FaqItem {
  q: string;
  a: string;
}
interface Props {
  items: FaqItem[];
}
const { items } = Astro.props;
---

<section aria-labelledby="faq-heading" class="mt-16">
  <h2 id="faq-heading" class="text-2xl font-semibold tracking-tight">Frequently asked questions</h2>
  <div class="mt-6 divide-y divide-line rounded-2xl border border-line bg-surface">
    {
      items.map((f) => (
        <details class="group px-5 py-4 [&_summary::-webkit-details-marker]:hidden">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-medium">
            {f.q}
            <span class="text-muted transition group-open:rotate-45 text-xl leading-none" aria-hidden="true">+</span>
          </summary>
          <p class="mt-3 leading-7 text-muted" set:html={f.a} />
        </details>
      ))
    }
  </div>
</section>
