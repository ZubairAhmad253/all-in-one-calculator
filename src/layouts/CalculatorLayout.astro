---
/**
 * Shared page shell for every calculator. A calculator page supplies:
 *   - the interactive widget (default slot, usually a React island)
 *   - long-form explanation (slot="learn")
 *   - FAQ items
 * and this layout handles breadcrumbs, ads, related links, blog links
 * and all structured data.
 */
import { getCollection } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '@/components/layout/Breadcrumbs.astro';
import AdSlot from '@/components/layout/AdSlot.astro';
import Faq, { type FaqItem } from '@/components/layout/Faq.astro';
import { SITE } from '@/config/site';
import { calculatorBySlug, relatedCalculators } from '@/data/calculators';
import { categoryById } from '@/data/categories';

interface Props {
  slug: string;
  /** SEO title, e.g. "Mortgage Calculator – Monthly Payment & Amortization". */
  title: string;
  description: string;
  /** Short lead paragraph under the H1. */
  intro: string;
  faqs: FaqItem[];
  updated: string;
}

const { slug, title, description, intro, faqs, updated } = Astro.props;
const calc = calculatorBySlug(slug);
if (!calc) throw new Error(`"${slug}" is not in src/data/calculators.ts`);
const category = categoryById(calc.category);
const related = relatedCalculators(slug);
const articles = (await getCollection('blog', ({ data }) => !data.draft && data.calculators.includes(slug))).slice(0, 3);

const pageUrl = new URL(`/${slug}`, Astro.site).href;
const crumbs = [
  { name: 'Home', href: '/' },
  { name: category.name, href: `/category/${category.id}` },
  { name: calc.name, href: `/${slug}` },
];

const APP_CATEGORY: Partial<Record<string, string>> = {
  finance: 'FinanceApplication',
  health: 'HealthApplication',
  education: 'EducationalApplication',
};

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: calc.name,
    url: pageUrl,
    description,
    applicationCategory: APP_CATEGORY[calc.category] ?? 'UtilitiesApplication',
    operatingSystem: 'Any',
    browserRequirements: 'Requires JavaScript',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    publisher: { '@type': 'Organization', name: SITE.name },
    dateModified: updated,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: crumbs.map((c, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: c.name,
      item: new URL(c.href, Astro.site).href,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
const updatedLabel = new Date(updated).toLocaleDateString('en', { year: 'numeric', month: 'long', day: 'numeric' });
---

<BaseLayout title={title} description={description} jsonLd={jsonLd}>
  <div class="container-page pt-6 pb-4">
    <Breadcrumbs items={crumbs} />
    <h1 class="mt-4 text-3xl font-bold tracking-tight text-balance sm:text-4xl">{calc.name}</h1>
    <p class="mt-3 max-w-3xl text-lg text-muted text-pretty">{intro}</p>
  </div>

  <div class="container-page">
    <slot />
  </div>

  <div class="container-page mt-10">
    <AdSlot height={100} class="mx-auto max-w-[728px]" />
  </div>

  <div class="container-page mt-6 grid gap-12 lg:grid-cols-[minmax(0,1fr)_300px]">
    <article class="min-w-0">
      <div class="prose-content">
        <slot name="learn" />
      </div>

      <Faq items={faqs} />

      <p class="mt-10 text-sm text-muted">
        Last updated {updatedLabel}. This calculator gives estimates for information only. Check figures with a qualified professional before making decisions.
      </p>
    </article>

    <aside class="space-y-8 lg:sticky lg:top-24 lg:self-start">
      {
        related.length > 0 && (
          <nav aria-labelledby="related-heading" class="card p-5">
            <h2 id="related-heading" class="text-sm font-semibold">Related calculators</h2>
            <ul class="mt-3 space-y-1">
              {related.map((r) => (
                <li><a href={`/${r.slug}`} class="block rounded-lg px-2 py-1.5 text-sm hover:bg-surface-2">{r.name}</a></li>
              ))}
            </ul>
          </nav>
        )
      }
      {
        articles.length > 0 && (
          <nav aria-labelledby="articles-heading" class="card p-5">
            <h2 id="articles-heading" class="text-sm font-semibold">Guides</h2>
            <ul class="mt-3 space-y-3">
              {articles.map((a) => (
                <li><a href={`/blog/${a.id}`} class="text-sm font-medium hover:text-brand">{a.data.title}</a></li>
              ))}
            </ul>
          </nav>
        )
      }
      <nav aria-label={`More ${category.name} calculators`} class="card p-5">
        <a href={`/category/${category.id}`} class="text-sm font-semibold hover:text-brand">All {category.name} calculators →</a>
      </nav>
      <AdSlot height={600} class="hidden lg:flex" />
    </aside>
  </div>
</BaseLayout>
